# Vars específicas del gateway (HTTP + auth + DB para la CLI de migraciones
# corrida desde el host). Las demás vars comunes se heredan del `.env` raíz
# vía el `env_file:` de docker-compose.

# HTTP
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth (debe coincidir con users-microservice/.env)
JWT_SECRET=change-me-in-prod

# Database para `npm run migration:*` desde el host.
# Dentro del container, el `.env` raíz pisa DB_HOST con `mysql_db`.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=testuser
DB_PASSWORD=testuser123
DB_DATABASE=nestjs_db

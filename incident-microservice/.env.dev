# Vars específicas de incident-microservice (dev local)
# Para activarlas: cp .env.dev .env

# S3 (archivos de incidentes). Dejar vacío si no vas a usar S3 en local.
AWS_REGION=us-east-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (emails de notificación). Dejar vacío si no vas a mandar mails en local.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost

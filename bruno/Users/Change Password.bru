meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/user/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "password123",
    "newPassword": "newpass123"
  }
}

docs {
  Cambia la contraseña del usuario autenticado.
}

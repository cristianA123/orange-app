# Vars específicas del gateway (dev local)
# Para activarlas: cp .env.dev .env

# HTTP
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth (compartido con users-microservice)
JWT_SECRET=dev-local-secret

# Database para la CLI de migraciones corrida desde el host:
# dotenv/config en src/data-source.ts carga ESTE archivo cuando corres
# `npm run migration:*` desde la terminal (CWD = http-api-gateway/).
# Como el puerto 3306 está publicado en localhost del host, usamos localhost.
# En runtime dentro del container, docker-compose pisa DB_HOST con mysql_db
# (via env_file del raíz, que va DESPUÉS de este archivo en el array).
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=testuser
DB_PASSWORD=testuser123
DB_DATABASE=nestjs_db
